<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Date Picker Form</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f7f9fc;
            color: #333;
            margin: 0;
            padding: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
        }

        .container {
            display: flex;
            flex-direction: column;
            justify-content: center;
            background-color: #f7f9fc;
            padding: 20px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            border-radius: 8px;
            gap: 20px;
            max-width: 368px;
            width: 100%;
        }

        .form-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background-color: #f5f5dc;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        .form-section {
            flex: 1;
        }

            .form-section h2 {
                margin-bottom: 20px;
                font-size: 18px;
                color: #333;
            }

        .form-group {
            margin-bottom: 15px;
        }

        label {
            font-size: 14px;
            color: #555;
            display: block;
            margin-bottom: 8px;
        }

        input[type="date"] {
            width: 100%;
            padding: 12px;
            font-size: 14px;
            border: 1px solid #ccc;
            border-radius: 4px;
            box-sizing: border-box;
            background-color: #f4f7f9;
        }

            input[type="date"]:focus {
                outline: none;
                border-color: #3498db;
                background-color: #ffffff;
            }

        .btn-container {
            display: flex;
            flex-direction: column;
            gap: 10px;
            padding-left: 19px;
            margin-top: 62px;
        }

        button {
            padding: 12px;
            background-color: #3498db;
            color: #ffffff;
            font-size: 16px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }

            button:hover {
                background-color: #2980b9;
            }

        .alert {
            color: #e74c3c;
            text-align: center;
            margin-top: 20px;
        }

        .alert-success {
            color: #2ecc71;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Date Picker Form -->
        <div class="form-container">
            <!-- Date Pickers Section -->
            <div class="form-section">
                <h2>Select Date Range</h2>
                <form id="dateForm">
                    <div class="form-group">
                        <label for="fromDate">From Date:</label>
                        <input type="date" id="fromDate" name="fromDate" required>
                    </div>
                    <div class="form-group">
                        <label for="toDate">To Date:</label>
                        <input type="date" id="toDate" name="toDate" required>
                    </div>
                </form>
            </div>

            <!-- Buttons Section -->
            <div class="btn-container">
                <button type="button" id="oneYearBtn">1 Year</button>
                <button type="button" id="threeMonthsBtn">3 Months</button>
                <button type="button" id="testButton">TEST</button>
            </div>
        </div>
    </div>

    <script>
        // Restrict the date pickers to prevent selecting tomorrow or later.
        document.addEventListener('DOMContentLoaded', function () {
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('fromDate').max = today;
            document.getElementById('toDate').max = today;
        });

        document.getElementById('oneYearBtn').addEventListener('click', function() {
            var today = new Date();
            var oneYearAgo = new Date(today.setFullYear(today.getFullYear() - 1));
            var startDate = new Date(oneYearAgo.getFullYear(), 0, 1);
            var endDate = new Date();

            var formattedStartDate = startDate.toISOString().split('T')[0];
            var formattedEndDate = endDate.toISOString().split('T')[0];

            document.getElementById('fromDate').value = formattedStartDate;
            document.getElementById('toDate').value = formattedEndDate;
        });

        document.getElementById('threeMonthsBtn').addEventListener('click', function() {
            var today = new Date();
            var threeMonthsAgo = new Date(today.setMonth(today.getMonth() - 3));
            var formattedStartDate = threeMonthsAgo.toISOString().split('T')[0];
            var formattedEndDate = new Date().toISOString().split('T')[0];

            document.getElementById('fromDate').value = formattedStartDate;
            document.getElementById('toDate').value = formattedEndDate;
        });

        document.getElementById('testButton').addEventListener('click', async function (event) {
            event.preventDefault();

            const fromDate = document.getElementById('fromDate').value;
            const toDate = document.getElementById('toDate').value;

            if (!fromDate || !toDate) {
                alert('Please select both From Date and To Date.');
                return;
            }

            let currentDate = new Date(fromDate);
            const endDate = new Date(toDate);

            while (currentDate <= endDate) {
                const requestBody = {
                    startDate: currentDate.toISOString().split('T')[0],
                    endDate: currentDate.toISOString().split('T')[0]
                };

                try {
                    // const response = await fetch('https://localhost:44364/api/Test/BulkTestMasterAPI', {
                    const response = await fetch('https://localhost:44364/api/TestDownTrend/BulkTestMasterAPI', {
                    // const response = await fetch('https://localhost:44364/api/TestUpTrend/BulkTestMasterAPI', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(requestBody)
                    });

                    currentDate.setDate(currentDate.getDate() + 1);

                    if (response.ok) {
                        const data = await response.json();
                        console.log('API Response:', data);

                        var Loss = 0;

                        data.extractedListWrongPredictions.forEach((item, index) => 
                        {
                         // Loss = Loss + 2.5 + ((item[1].endPrice - item[0].highestPrice)*5);

                          if (item && item[1] && item[0]) {  // Check if item and both indices exist
                              Loss = Loss + 117 + ((item[1].endPrice - item[0].highestPrice) * 5);
                          }
                        });

                       console.log('Profit - Loss', data.net - Loss , 'Profit' , data.net , 'Loss', Loss)

                    } else {
                        console.error('API Call Failed:', response.statusText);
                    }
                } catch (error) {
                    console.error('Error during API call:', error);
                }
            }

        });
    </script>
</body>
</html>
