<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Date Picker Form</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f7f9fc;
            color: #333;
            margin: 0;
            padding: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
        }

        .container {
            display: flex;
            flex-direction: column;
            justify-content: center;
            background-color: #f7f9fc;
            padding: 20px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            border-radius: 8px;
            gap: 20px;
            max-width: 480px;
            width: 100%;
        }

        .form-container {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            background-color: #f5f5dc;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            gap: 16px;
        }

        .form-section {
            flex: 1;
        }

            .form-section h2 {
                margin-bottom: 12px;
                font-size: 18px;
                color: #333;
            }

        .form-group {
            margin-bottom: 12px;
        }

        label {
            font-size: 14px;
            color: #555;
            display: block;
            margin-bottom: 6px;
        }

        input[type="date"] {
            width: 100%;
            padding: 10px;
            font-size: 14px;
            border: 1px solid #ccc;
            border-radius: 4px;
            box-sizing: border-box;
            background-color: #f4f7f9;
        }

            input[type="date"]:focus {
                outline: none;
                border-color: #3498db;
                background-color: #ffffff;
            }

        .btn-container {
            display: flex;
            flex-direction: column;
            gap: 10px;
            padding-left: 8px;
            margin-top: 8px;
            min-width: 110px;
        }

        button {
            padding: 10px;
            background-color: #3498db;
            color: #ffffff;
            font-size: 14px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            transition: background-color 0.2s ease;
        }

            button:hover {
                background-color: #2980b9;
            }

            button[disabled] {
                opacity: 0.6;
                cursor: not-allowed;
            }

        .alert {
            color: #e74c3c;
            text-align: center;
            margin-top: 10px;
        }

        .alert-success {
            color: #2ecc71;
        }

        .results {
            margin-top: 12px;
            padding: 12px;
            background: #ffffff;
            border-radius: 6px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.06);
            font-size: 14px;
        }

        .progress {
            margin-top: 8px;
            font-size: 13px;
            color: #333;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Date Picker Form -->
        <div class="form-container">
            <!-- Date Pickers Section -->
            <div class="form-section">
                <h2>Select Date Range</h2>
                <form id="dateForm">
                    <div class="form-group">
                        <label for="fromDate">From Date:</label>
                        <input type="date" id="fromDate" name="fromDate" required>
                    </div>
                    <div class="form-group">
                        <label for="toDate">To Date:</label>
                        <input type="date" id="toDate" name="toDate" required>
                    </div>
                </form>
                <div id="progress" class="progress" aria-live="polite"></div>
                <div id="results" class="results" style="display:none;"></div>
            </div>

            <!-- Buttons Section -->
            <div class="btn-container">
                <button type="button" id="oneYearBtn">1 Year</button>
                <button type="button" id="threeMonthsBtn">3 Months</button>
                <button type="button" id="testButton">TEST</button>
            </div>
        </div>
    </div>

    <script>
        // Restrict the date pickers to prevent selecting tomorrow or later.
        document.addEventListener('DOMContentLoaded', function () {
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('fromDate').max = today;
            document.getElementById('toDate').max = today;

            // Optionally set defaults (last 3 days)
            const to = new Date();
            const from = new Date();
            from.setDate(to.getDate() - 2);
            document.getElementById('fromDate').value = from.toISOString().split('T')[0];
            document.getElementById('toDate').value = to.toISOString().split('T')[0];
        });

        document.getElementById('oneYearBtn').addEventListener('click', function() {
            const today = new Date();
            const oneYearAgo = new Date(today.getFullYear() - 1, 0, 1);
            const formattedStartDate = oneYearAgo.toISOString().split('T')[0];
            const formattedEndDate = new Date().toISOString().split('T')[0];
            document.getElementById('fromDate').value = formattedStartDate;
            document.getElementById('toDate').value = formattedEndDate;
        });

        document.getElementById('threeMonthsBtn').addEventListener('click', function() {
            const today = new Date();
            const threeMonthsAgo = new Date();
            threeMonthsAgo.setMonth(today.getMonth() - 3);
            const formattedStartDate = threeMonthsAgo.toISOString().split('T')[0];
            const formattedEndDate = new Date().toISOString().split('T')[0];
            document.getElementById('fromDate').value = formattedStartDate;
            document.getElementById('toDate').value = formattedEndDate;
        });

        // Helper to add days to a Date shallow copy
        function addDays(date, days) {
            const d = new Date(date);
            d.setDate(d.getDate() + days);
            return d;
        }

        // Main TEST button logic
        document.getElementById('testButton').addEventListener('click', async function (event) {
            event.preventDefault();

            const testBtn = document.getElementById('testButton');
            const fromVal = document.getElementById('fromDate').value;
            const toVal = document.getElementById('toDate').value;
            const progressEl = document.getElementById('progress');
            const resultsEl = document.getElementById('results');

            resultsEl.style.display = 'none';
            progressEl.textContent = '';

            if (!fromVal || !toVal) {
                alert('Please select both From Date and To Date.');
                return;
            }

            let currentDate = new Date(fromVal + 'T00:00:00'); // ensure timezone neutrality
            const endDate = new Date(toVal + 'T00:00:00');

            if (currentDate > endDate) {
                alert('From Date must be on or before To Date.');
                return;
            }

            // disable button while running
            testBtn.disabled = true;

            // Totals we will aggregate across all days
            let aggregate = {
                daysProcessed: 0,
                totalCorrect: 0,
                totalWrong: 0,
                totalTotal: 0,
                errors: 0
            };

            // iterate dates inclusive
            while (currentDate <= endDate) {
                const isoDate = currentDate.toISOString().split('T')[0];

                progressEl.textContent = `Processing ${isoDate} ... (processed ${aggregate.daysProcessed} days so far)`;

                const requestBody = {
                    // The server code you provided uses request.StartDate.
                    // We include both StartDate and EndDate as same day for safety.
                    StartDate: isoDate,
                    EndDate: isoDate
                };

                try {
                    const response = await fetch('https://localhost:44364/api/TestShortSell/RSIBulkTester', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(requestBody)
                    });

                    if (response.ok) {
                        const data = await response.json();

                        // The server returns at least these counts in your example:
                        // { CorrectStockCount, WrongStockCount, TotalStockCount }
                        const correct = Number(data.CorrectStockCount || data.correctStockCount || 0);
                        const wrong = Number(data.WrongStockCount || data.wrongStockCount || 0);
                        const total = Number(data.TotalStockCount || data.totalStockCount || 0);

                        aggregate.daysProcessed += 1;
                        aggregate.totalCorrect += correct;
                        aggregate.totalWrong += wrong;
                        aggregate.totalTotal += total;

                        console.log(`${isoDate} -> Correct: ${correct}, Wrong: ${wrong}, Total: ${total}`, data);
                    } else {
                        aggregate.errors += 1;
                        console.error(`API call failed for ${isoDate}:`, response.status, response.statusText);
                    }
                } catch (err) {
                    aggregate.errors += 1;
                    console.error(`Error calling API for ${isoDate}:`, err);
                }

                // move to next date
                currentDate = addDays(currentDate, 1);
            }

            // show final aggregated result
            resultsEl.style.display = 'block';
            resultsEl.innerHTML = `
                <strong>Summary</strong>
                <div>Days processed: ${aggregate.daysProcessed}</div>
                <div>Total CorrectStockCount: ${aggregate.totalCorrect}</div>
                <div>Total WrongStockCount: ${aggregate.totalWrong}</div>
                <div>Total TotalStockCount: ${aggregate.totalTotal}</div>
                <div style="color:${aggregate.errors ? '#e74c3c' : '#2ecc71'}">API errors: ${aggregate.errors}</div>
            `;

            progressEl.textContent = 'Done.';
            testBtn.disabled = false;
        });
    </script>
</body>
</html>
