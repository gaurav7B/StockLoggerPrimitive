<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        .container {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 10px;
            padding: 20px;
            width: 100vw;
            box-sizing: border-box;
        }

        .box {
            background-color: #4CAF50;
            height: 70px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 10px;
            box-sizing: border-box;
            color: white;
            font-family: Arial, sans-serif;
            font-size: 14px;
            border-radius: 4px;
        }

        .box-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
        }

        .red-box {
            background-color: red;
            width: 15px;
            height: 15px;
            margin-left: 10px;
            border-radius: 3px;
            opacity: 1;
            transition: opacity 0.5s ease-in-out;
        }

        .company-name {
            font-weight: bold;
            margin-bottom: 5px;
            text-transform: uppercase;
        }

        /* Wrap the buttons in a container and use flexbox */
        .button-container {
            display: flex;
            gap: 10px; /* Space between buttons */
            justify-content: space-between; /* Align buttons side by side */
        }

            /* Style the individual button to ensure equal width */
            .button-container button {
                width: 48%; 
                padding: 8px 16px;
            }

        .form-container {
            background-color: #f5f5dc;
            padding: 20px;
            margin-bottom: 20px;
            border-radius: 8px;
        }

            .form-container h2 {
                color: #333;
                font-size: 168%;
            }

            .form-container label.correct-prediction {
                color: green;
            }

            .form-container label.wrong-prediction {
                color: red;
            }

            .form-container label {
                color: #333;
                font-size: 1.1em;
            }

            .form-container input {
                color: #333;
                background-color: #fff;
                border: 1px solid #ccc;
                padding: 10px;
                width: 100%;
                font-size: 1em;
                border-radius: 4px;
            }

        button.btn {
            color: #fff;
            margin-top: 10px;
            border: none;
            padding: 4px 0px; 
            border-radius: 4px;
            cursor: pointer;
            width: 100%;
            transition: background-color 0.3s ease;
        }

            button.btn:hover {
                background-color: #4a8fd4;
            }

    </style>
</head>
