        function AnalyzeCandelData(data, Name) {

            const url = `${apiCandelUrl}${data.detectionTime}&ticker=${data.ticker}&tickerId=${data.tickerId}`;

             const url2 = `https://localhost:44364/api/StockPricePerSec/ByDateTime?dateTime=${encodeURIComponent(data.detectionTime)}&tickerId=${data.tickerId}`;

             fetch(url2)
                .then(response => response.json()) // Parse the JSON response
                .then(data => {

                    let FirstPrice = data[0];
                    let SecondPrice = data[1];


                
                }) // Log the response data
                .catch(error => console.error('Error:', error)); // Catch any errors

            fetch(url)
                .then(response => response.json())
                .then(data => {
                    let DetectionCandel = data[0]
                    let NextCandel = data[1]
                    let FarthestCandel = data[2]

                    if (NextCandel.endPrice > DetectionCandel.endPrice) {
                        predictions[`correct${Name}Prediction`].push(data);

                        let DataLength = predictions[`correct${Name}Prediction`].length;
                        document.getElementById(`${Name}correctPredictions`).value = DataLength;
                    } else if (NextCandel.endPrice < DetectionCandel.endPrice) {
                        if (FarthestCandel.endPrice > DetectionCandel.endPrice) {
                            predictions[`correct${Name}Prediction`].push(data);

                            let DataLength = predictions[`correct${Name}Prediction`].length;
                            document.getElementById(`${Name}correctPredictions`).value = DataLength;
                        } else if (FarthestCandel.endPrice < DetectionCandel.endPrice) {
                            predictions[`wrong${Name}Prediction`].push(data);

                            let DataLength = predictions[`wrong${Name}Prediction`].length;
                            document.getElementById(`${Name}wrongPredictions`).value = DataLength;

                            console.log(`${Name}wrongPredictions`, data);
                        } else {
                            predictions[`wrong${Name}Prediction`].push(data);

                            let DataLength = predictions[`wrong${Name}Prediction`].length;
                            document.getElementById(`${Name}wrongPredictions`).value = DataLength;

                            console.log(`${Name}wrongPredictions`, data);
                        }
                    }

                    // Calculate accuracy
                    let totalPredictions = predictions[`correct${Name}Prediction`].length + predictions[`wrong${Name}Prediction`].length;
                    let accuracy = (totalPredictions > 0) ? (predictions[`correct${Name}Prediction`].length / totalPredictions) * 100 : 0;
                    document.getElementById(`${Name}Accuracy`).value = `${accuracy.toFixed(2)}%`;
                })
                .catch(error => {
                    console.error('Error fetching data:', error);
                });
        }

        async function fetchData() {
            try {
                const response = await fetch(apiHammerUrl);
                if (!response.ok) {
                    console.error(`Error fetching Hammer data: ${response.status} ${response.statusText}`);
