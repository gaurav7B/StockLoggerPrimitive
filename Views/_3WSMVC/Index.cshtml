        let totalProfit = 0; // Variable to store total profit
        let totalLoss = 0;   // Variable to store total loss

        function fetchCandelData(data, Name) {
            const url = `${apiCandelUrl}${data.detectionTime}&ticker=${data.ticker}&tickerId=${data.tickerId}`;

            fetch(url)
                .then(response => response.json())
                .then(data => {
                    Globalarray.push({ Stratergyname: Name, data: data });

                    let DetectionCandel = data[0];
                    let NextCandel = data[1];
                    let FarthestCandel = data[2];

                    console.log("DetectionCandel", DetectionCandel, DetectionCandel.endPrice);
                    console.log("NextCandel", NextCandel, NextCandel.endPrice);

                    if (NextCandel.endPrice > DetectionCandel.endPrice) {
                        correctPrediction.push({ Stratergyname: Name, data: data });

                        // Calculate profit
                        let profit = NextCandel.endPrice - DetectionCandel.endPrice;
                        totalProfit += profit;
                    } else if (NextCandel.endPrice < DetectionCandel.endPrice) {
                        if (FarthestCandel.endPrice > DetectionCandel.endPrice) {
                            correctPrediction.push({ Stratergyname: Name, data: data });

                            // Calculate profit
                            let profit = FarthestCandel.endPrice - DetectionCandel.endPrice;
                            totalProfit += profit;
                        } else if (FarthestCandel.endPrice < DetectionCandel.endPrice) {
                            wrongPredictions.push({ Stratergyname: Name, data: data });

                            // Calculate loss
                            let loss = DetectionCandel.endPrice - FarthestCandel.endPrice;
                            totalLoss += loss;
                        } else {
                            wrongPredictions.push({ Stratergyname: Name, data: data });

                            // Optional: Calculate loss for the flat case (if needed)
                            let loss = DetectionCandel.endPrice - FarthestCandel.endPrice; // This might be zero
                            totalLoss += loss;
                        }
                    }
                })
                .catch(error => {
                    console.error('Error fetching data:', error);
                });
        }

        // Log final results
        function logProfitAndLoss() {
            console.log("Total Profit:", totalProfit);
            console.log("Total Loss:", totalLoss);

            let netResult = totalProfit - totalLoss;
            console.log("Net Result (Profit - Loss):", netResult);
        }

