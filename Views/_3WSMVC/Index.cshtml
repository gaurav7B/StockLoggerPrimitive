        // Function to fetch data based on ticker, tickerId, and detectionTime
        function fetchCandelData(data, Name) {
            const url = `${apiCandelUrl}${data.detectionTime}&ticker=${data.ticker}&tickerId=${data.tickerId}`;

            fetch(url)
                .then(response => response.json())
                .then(data => {
                            Globalarray.push({ Stratergyname: Name, data: data });
                })
                .catch(error => {
                    console.error('Error fetching data:', error);
                });
        }

